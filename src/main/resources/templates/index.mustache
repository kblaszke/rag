{{> header}}
<div class="center">
<h1>AI Client</h1>

<form action="/" method="post">
    <input type="hidden" name="conversationId" value="{{conversationId}}"/>
    <div>
        <input id="attachDocumentation" type="radio" name="attachDocumentation" value="true" checked/>
        <label for="attachDocumentation">dołącz źródła</label>
        <input id="straitQuestion" type="radio" name="attachDocumentation" value="false"/>
        <label for="assistant_role">bez źródeł</label>
    </div>
    <div>
        <textarea type="text" name="prompt" cols="80" rows="8"></textarea>
    </div>
  <input type="submit">
</form>
<div class="center">
    {{answer}}
</div>
</div>

{{> footer}}